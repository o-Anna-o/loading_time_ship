{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "src_tauri",
  "version": "0.1.0",
  "identifier": "com.loading-time.ship",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "src_tauri",
        "width": 1200,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' http://192.168.56.1:8080 http://192.168.56.1:9000; connect-src 'self' http://192.168.56.1:8080 http://192.168.56.1:9000 ws://localhost:1421; img-src 'self' asset: https://asset.localhost http://192.168.56.1:9000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
